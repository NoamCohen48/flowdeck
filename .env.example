# Copy to .env and edit. `docker compose up -d` reads it.

# Signs the identity cookie. Optional: leave empty and one is generated on first
# boot and kept on the data volume. To set your own: openssl rand -hex 32
COOKIE_SECRET=

# Where the site is served. `localhost` uses Caddy's own certificate;
# a public hostname (flowdeck.example.com) gets a real one automatically.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Load the fictional Relay data on first boot (skipped when products exist).
SEED_DEMO=true

# Attachments are kept forever; warn and refuse past this many megabytes.
ATTACHMENTS_BUDGET_MB=2048

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=flowdeck-dev

# Off-host backups (docs/backup.md). Leave BACKUP_REPOSITORY empty and the
# backup service idles. Point it at the S3 inside your network and it takes a
# snapshot on start and then every BACKUP_INTERVAL: the database dump plus every
# attachment, encrypted with BACKUP_PASSWORD before it leaves the host. Losing
# that password means losing the backups: keep it somewhere other than this host.
BACKUP_REPOSITORY=
# BACKUP_REPOSITORY=s3:https://s3.internal.example/flowdeck-backups
BACKUP_PASSWORD=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_INTERVAL=24h
# How many snapshots to keep, as restic `forget` flags.
BACKUP_KEEP=--keep-last 3 --keep-daily 7 --keep-weekly 4 --keep-monthly 12
