# Copy to .env and edit. `docker compose up -d` reads it.

# Required: signs the identity cookie. Generate one: openssl rand -hex 32
COOKIE_SECRET=

# Where the site is served. `localhost` uses Caddy's own certificate;
# a public hostname (flowdeck.example.com) gets a real one automatically.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Load the fictional Relay data on first boot (skipped when products exist).
SEED_DEMO=true

# Attachments are kept forever; warn and refuse past this many megabytes.
ATTACHMENTS_BUDGET_MB=2048

# Database password for the bundled Postgres.
POSTGRES_PASSWORD=flowdeck-dev
